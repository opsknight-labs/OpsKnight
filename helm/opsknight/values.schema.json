{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "runtime": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["integrated", "split"] }
      }
    },
    "scheduler": {
      "type": "object",
      "properties": {
        "profile": { "type": "string", "enum": ["full", "maintenance"] },
        "replicaCount": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
