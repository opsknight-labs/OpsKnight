{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "runtime": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["integrated", "split"]
        }
      },
      "required": ["mode"]
    },
    "pgbouncer": {
      "type": "object",
      "properties": {
        "poolMode": {
          "type": "string",
          "enum": ["transaction"]
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^(|sha256:[a-f0-9]{64})$"
            }
          }
        }
      }
    }
  }
}
