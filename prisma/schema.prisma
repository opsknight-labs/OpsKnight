  PROCESSING
  COMPLETED
  FAILED
}

enum WarRoomProviderEventStageStatus {
  PENDING
  ATTEMPTING
  COMPLETED
  FAILED
  AMBIGUOUS
  SKIPPED
}

model WarRoomProviderEventDelivery {
