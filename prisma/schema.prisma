generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  RESPONDER
  AUDITOR
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum RoleSource {
  MANUAL
  OIDC
  SCIM
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum AuditEntityType {
  USER
  TEAM
  TEAM_MEMBER
  SERVICE
  INCIDENT
  ESCALATION_POLICY
  API_KEY
  SSO_CONFIG
  SCHEDULE
  CUSTOM_FIELD
  STATUS_PAGE
  SYSTEM_CONFIG
  PRIVACY_REQUEST
  PRIVACY_EXPORT_ARTIFACT
  PRIVACY_ERASURE_EXECUTION
  DATA_RETENTION_HOLD
  ENCRYPTION_MIGRATION
}

// Data subject a privacy request concerns. Only USER is operable in Phase 2;
// STATUS_SUBSCRIBER exists so the schema doesn't need another migration for it.
enum PrivacyRequestSubjectType {
  USER
  STATUS_SUBSCRIBER
}

enum PrivacyRequestType {
  ACCESS
  RECTIFICATION
  ERASURE
  RESTRICTION
  OBJECTION
  PORTABILITY
}

enum PrivacyRequestStatus {
  RECEIVED
  IDENTITY_VERIFICATION
  IN_REVIEW
  PROCESSING
  BLOCKED
  COMPLETED
  REJECTED
}

enum PrivacyExportArtifactStatus {
  PENDING
  READY
  DOWNLOADED
  EXPIRED
  FAILED
}

enum PrivacyErasureExecutionStatus {
  PENDING
  RUNNING
  PARTIAL
  COMPLETED
  FAILED
}

enum RetentionHoldScopeType {
  USER
  INCIDENT
  PRIVACY_REQUEST
}

enum UserTokenType {
  INVITE
  PASSWORD_RESET
  ADMIN_RESET_LINK
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  PARTIAL_OUTAGE
  MAJOR_OUTAGE
  MAINTENANCE
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  SNOOZED
  SUPPRESSED
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum InboundDeliveryStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  SLACK
  WEBHOOK
  WHATSAPP
  MICROSOFT_TEAMS
}

enum MicrosoftTeamsTenantMode {
  SINGLE
  MULTI
}

enum WarRoomProvider {
  SLACK
  MICROSOFT_TEAMS
}

enum WarRoomState {
  PROVISIONING
  READY
  CLOSING
  CLOSED
  ARCHIVED
  FAILED
  AMBIGUOUS
}

enum WarRoomMembershipType {
  STANDARD
  PRIVATE
}

enum WarRoomParticipantSource {
  ASSIGNEE
  WATCHER
  ESCALATION
  TEAM
  MANUAL
}

enum WarRoomParticipantState {
  DESIRED
  // Retained for rolling deploy compatibility with foundation workers.
  PROCESSING
  PENDING
  PRESENT
  SKIPPED
  FAILED
  REMOVED
}

enum WarRoomHealthState {
  HEALTHY
  DEGRADED
  MISSING
  PERMISSION_ERROR
}

enum IncidentMeetingProvider {
  MICROSOFT_TEAMS
  ZOOM
  GOOGLE_MEET
  JITSI
  NONE
}

enum IncidentMeetingState {
  REQUESTED
  PROVISIONING
  READY
  CLOSING
  CLOSED
  FAILED
}

enum IncidentMeetingHealth {
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

enum NotificationTrafficClass {
  CRITICAL
  TRANSACTIONAL
  PUBLIC_INCIDENT
  BULK
}

enum StatusPageSubscriptionState {
  PENDING
  ACTIVE
  UNSUBSCRIBED
  SUPPRESSED
  BOUNCED
  COMPLAINED
}

enum StatusPageAnnouncementNotificationTiming {
  NONE
  ON_PUBLISH
  AT_START
}

enum NotificationCategory {
  INCIDENT
  SECURITY
  STATUS_PAGE
  SLA
  ADMINISTRATION
  SYSTEM
}

enum NotificationRecipientType {
  USER
  EMAIL
  PHONE
  SUBSCRIBER
  SLACK_CHANNEL
  WEBHOOK
  MICROSOFT_TEAMS_CHANNEL
}

enum InAppNotificationType {
  INCIDENT
  SCHEDULE
  TEAM
  SERVICE
  ACTION_ITEM
}

enum IncidentUrgency {
  LOW
  MEDIUM
  HIGH
}

enum IncidentResolutionKind {
  MANUAL
  SOURCE_RECOVERY
  AUTOMATION
  AUTO_TIMEOUT
  UNKNOWN
}

enum IncidentVisibility {
  PUBLIC
  PRIVATE
}

enum DashboardVisibility {
  PRIVATE
  TEAM
  PUBLIC
}

enum EscalationTargetType {
  USER
  TEAM
  SCHEDULE
}

enum IncidentEventType {
  ACKNOWLEDGED
  ESCALATED
  SLA_WARNING
  SLA_BREACHED
  REOPENED
  AUTO_RESOLVED
  MANUAL_RESOLVED
  COMMENT
  STATUS_CHANGE
  ASSIGNMENT
  LEGACY_OTHER
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum ActionItemPriority {
  HIGH
  MEDIUM
  LOW
}

enum ActionItemSource {
  POSTMORTEM
  MANUAL
}

enum ExternalIssueProvider {
  JIRA
  MICROSOFT_TEAMS
}

enum ExternalIssueSyncState {
  PENDING
  SYNCED
  FAILED
}

enum ExternalOperationStatus {
  PENDING
  PROCESSING
  AMBIGUOUS
  COMPLETED
  FAILED
}

model ExternalOperation {
  id             String                  @id @default(cuid())
  provider       ExternalIssueProvider
  operation      String
  idempotencyKey String
  incidentId     String?
  actionItemId   String?
  status         ExternalOperationStatus @default(PENDING)
  leaseToken     String?
  leaseExpiresAt DateTime?
  externalId     String?
  externalKey    String?
  requestPayload Json?
  resultPayload  Json?
  lastError      String?
  attempts       Int                     @default(0)
  nextAttemptAt  DateTime                @default(now())
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([provider, idempotencyKey])
  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@index([incidentId, operation])
  @@index([actionItemId, operation])
}

model ProviderAdmission {
  key              String    @id
  state            String    @default("CLOSED")
  blockedUntil     DateTime?
  consecutiveFails Int       @default(0)
  lastSuccessAt    DateTime?
  lastFailureAt    DateTime?
  lastStatusCode   Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([state, blockedUntil])
}

model ProviderQuotaWindow {
  id          String   @id
  providerKey String
  channel     String
  windowStart DateTime
  globalUsed  Int      @default(0)
  bulkUsed    Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([providerKey, channel, windowStart])
  @@index([expiresAt])
}

model ProviderWorkerLease {
  id            String   @id
  workerId      String
  providerKey   String
  channel       String
  reservedSlots Int
  expiresAt     DateTime
  heartbeatAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([workerId, providerKey, channel])
  @@index([providerKey, channel, expiresAt])
  @@index([expiresAt])
}

model User {
  id                           String     @id @default(cuid())
  name                         String
  email                        String     @unique
  emailVerified                DateTime?
  tokenVersion                 Int        @default(0)
  invitationGeneration         Int        @default(0)
  role                         Role       @default(USER)
  roleSource                   RoleSource @default(MANUAL)
  scimExternalId               String?    @unique
  status                       UserStatus @default(INVITED)
  passwordHash                 String?
  timeZone                     String     @default("UTC")
  emailNotificationsEnabled    Boolean    @default(false)
  smsNotificationsEnabled      Boolean    @default(false)
  pushNotificationsEnabled     Boolean    @default(false)
  whatsappNotificationsEnabled Boolean    @default(false)
  phoneNumber                  String?
  quietHoursEnabled            Boolean    @default(false)
  quietHoursStartMinutes       Int        @default(1080)
  quietHoursEndMinutes         Int        @default(480)
  quietHoursWeekendAllDay      Boolean    @default(true)
  department                   String?
  jobTitle                     String?
  avatarUrl                    String?
  gender                       String?
  lastOidcSync                 DateTime?
  invitedAt                    DateTime?
  deactivatedAt                DateTime?
  createdAt                    DateTime   @default(now())
  updatedAt                    DateTime   @updatedAt

  assignedIncidents    Incident[]
  teamMemberships      TeamMember[]
  onCallShifts         OnCallShift[]
  escalationRules      EscalationRule[]
  incidentNotes        IncidentNote[]
  postmortems          Postmortem[]
  notifications        Notification[]
  inAppNotifications   InAppNotification[]
  devices              UserDevice[]
  incidentWatchers     IncidentWatcher[]
  auditLogs            AuditLog[]
  overrides            OnCallOverride[]    @relation("OverrideUser")
  overrideReplacements OnCallOverride[]    @relation("OverrideReplacesUser")
  layerAssignments     OnCallLayerUser[]
  apiKeys                     ApiKey[]
  incidentTemplates           IncidentTemplate[]
  updatedProviders            NotificationProvider[]
  teamsLed                    Team[]                       @relation("TeamLead")
  slackIntegrations           SlackIntegration[]
  slackOAuthConfigs           SlackOAuthConfig[]           @relation("SlackOAuthConfigUpdater")
  jiraConfigsUpdated          JiraConfig[]                 @relation("JiraConfigUpdater")
  microsoftTeamsConfigs       MicrosoftTeamsConfig[]       @relation("MicrosoftTeamsConfigUpdater")
  microsoftTeamsInstallations MicrosoftTeamsInstallation[] @relation("MicrosoftTeamsInstallationInstaller")
  microsoftTeamsDestinations  MicrosoftTeamsDestination[]  @relation("MicrosoftTeamsDestinationUpdater")
  warRoomParticipants         WarRoomParticipant[]
  chatIdentityLinks           ChatIdentityLink[]
  oidcConfigs                 OidcConfig[]
  oidcIdentities              OidcIdentity[]
  oidcLinkingApproval         OidcLinkingApproval?
  avatar                      UserAvatar?
  dashboards                  Dashboard[]
  assignedActionItems         ActionItem[]
  tokens                      UserToken[]
  privacyRequestsAssigned     PrivacyRequest[]             @relation("PrivacyRequestAssignedTo")
  privacyRequestsRequested    PrivacyRequest[]             @relation("PrivacyRequestRequestedBy")
  createdRetentionHolds       DataRetentionHold[]          @relation("RetentionHoldCreatedBy")
  releasedRetentionHolds      DataRetentionHold[]          @relation("RetentionHoldReleasedBy")
  initiatedEncryptionRuns     EncryptionMigrationRun[]     @relation("EncryptionRunInitiator")

  @@index([email])
  @@index([role, status])
  @@index([status])
}

model UserAvatar {
  userId    String   @id
  data      Bytes
  mimeType  String
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OidcIdentity {
  id               String    @id @default(cuid())
  issuer           String
  subject          String
  email            String?
  providerConfigId String?   @default("default")
  providerObjectId String?
  tenantId         String?
  issuerFingerprint String?
  emailAtLink      String?
  lastLoginAt      DateTime?
  userId           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([issuer, subject])
  @@index([userId])
  @@index([issuer])
  @@index([providerConfigId])
  @@index([issuerFingerprint])
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members           TeamMember[]
  services          Service[]
  escalationRules   EscalationRule[]
  incidentTemplates IncidentTemplate[]
  incidents         Incident[]
  dashboards        Dashboard[]
  teamLeadId        String?
  teamLead          User? @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
}

model TeamMember {
  id                       String   @id @default(cuid())
  userId                   String
  teamId                   String
  role                     TeamRole @default(MEMBER)
  receiveTeamNotifications Boolean  @default(true)
  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])
  @@unique([userId, teamId])
  @@index([teamId])
}

model Service {
  id                          String                @id @default(cuid())
  name                        String                @unique
  description                 String?
  region                      String?
  slaTier                     String?
  status                      ServiceStatus         @default(OPERATIONAL)
  targetAckMinutes            Int                   @default(15)
  targetResolveMinutes        Int                   @default(120)
  teamId                      String?
  escalationPolicyId          String?
  slackWebhookUrl             String?
  slackChannel                String?
  slackWorkspaceId            String?
  slackIntegrationId          String?
  webhookUrl                  String?
  serviceNotificationChannels NotificationChannel[] @default([])
  serviceNotifyOnTriggered    Boolean               @default(true)
  serviceNotifyOnAck          Boolean               @default(true)
  serviceNotifyOnResolved     Boolean               @default(true)
  serviceNotifyOnSlaBreach    Boolean               @default(false)
  defaultIncidentVisibility   IncidentVisibility    @default(PUBLIC)
  autoCreateWarRoom           Boolean               @default(false)
  microsoftTeamsWarRoomAutoCreate Boolean           @default(false)
  warRoomVideoBridge          String?
  warRoomCustomBridgeUrl      String?
  slaDefinitions              SLADefinition[]
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  team      Team?             @relation(fields: [teamId], references: [id])
  incidents Incident[]
  policy    EscalationPolicy? @relation(fields: [escalationPolicyId], references: [id])
  integrations              Integration[]
  alerts                    Alert[]
  incidentTemplates         IncidentTemplate[]
  statusPageServices        StatusPageService[]
  webhookIntegrations       WebhookIntegration[]
  slackIntegration          SlackIntegration? @relation("ServiceSlackIntegration", fields: [slackIntegrationId], references: [id], onDelete: SetNull)
  jiraServiceMapping        JiraServiceMapping?
  subscriptionServices      StatusPageSubscriptionService[]
  microsoftTeamsDestinations MicrosoftTeamsDestination[]
  @@index([teamId])
  @@index([escalationPolicyId])
  @@index([slackIntegrationId])
}

model EscalationPolicy {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  steps EscalationRule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  services Service[]
}

model EscalationRule {
  id       String           @id @default(cuid())
  policyId String
  policy   EscalationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  delayMinutes Int @default(0)
  stepOrder    Int
  targetType       EscalationTargetType @default(USER)
  targetUserId     String?
  targetTeamId     String?
  targetScheduleId String?
  notificationChannels NotificationChannel[]
  notifyOnlyTeamLead Boolean @default(false)
  targetUser     User? @relation(fields: [targetUserId], references: [id])
  targetTeam     Team? @relation(fields: [targetTeamId], references: [id])
  targetSchedule OnCallSchedule? @relation(fields: [targetScheduleId], references: [id])
  conditions     EscalationRuleCondition[]
  @@unique([policyId, stepOrder])
  @@index([policyId])
  @@index([targetUserId])
  @@index([targetTeamId])
  @@index([targetScheduleId])
}

model EscalationRuleCondition {
  id       String         @id @default(cuid())
  ruleId   String
  field    String
  operator String
  values   String[]
  rule     EscalationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  @@index([ruleId])
}

model Integration {
  id              String   @id @default(cuid())
  name            String
  type            String   @default("EVENTS_API_V2")
  key             String   @unique
  signatureSecret String?
  snsTopicArn     String?
  enabled         Boolean  @default(true)
  serviceId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@index([serviceId])
  @@index([type, snsTopicArn])
}

model InboundDelivery {
  id             String                @id @default(cuid())
  integrationId  String
  provider       String
  deliveryHash   String
  status         InboundDeliveryStatus @default(PROCESSING)
  attempt        Int                   @default(1)
  leaseToken     String?
  leaseExpiresAt DateTime?
  lastError      String?
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  @@unique([integrationId, deliveryHash])
  @@index([status, leaseExpiresAt])
}

model WebhookIntegration {
  id        String   @id @default(cuid())
  serviceId String
  name      String
  type      String
  url       String
  secret    String?
  channel   String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@unique([serviceId, name])
  @@index([serviceId])
}

model SlackOAuthConfig {
  id            String   @id @default(cuid())
  clientId      String
  clientSecret  String
  signingSecret String?
  redirectUri   String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedBy     String?
  updater       User? @relation("SlackOAuthConfigUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  @@unique([id])
}

model OidcConfig {
  id                      String   @id @default("default")
  issuer                  String
  clientId                String
  clientSecret            String
  enabled                 Boolean  @default(true)
  configVersion           Int      @default(1)
  autoProvision           Boolean  @default(true)
  allowedDomains          String[] @default([])
  roleMapping             Json?    @default("[]")
  customScopes            String?
  providerType            String?
  providerLabel           String?
  organizationId          String?
  tokenEndpointAuthMethod String?  @default("client_secret_basic")
  profileMapping          Json?    @default("{}")
  sessionMaxAgeSeconds      Int?
  sessionIdleTimeoutSeconds Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  updatedBy               String?
  updater                 User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
  @@unique([id])
}

model SlackIntegration {
  id            String   @id @default(cuid())
  workspaceId   String
  workspaceName String?
  botToken      String
  signingSecret String?
  installedBy   String?
  scopes        String[]
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  services  Service[] @relation("ServiceSlackIntegration")
  installer User? @relation(fields: [installedBy], references: [id], onDelete: SetNull)
  @@unique([workspaceId])
  @@index([workspaceId])
}

model MicrosoftTeamsConfig {
  id           String                   @id @default(cuid())
  clientId     String
  clientSecret String
  tenantId     String?
  tenantMode   MicrosoftTeamsTenantMode @default(SINGLE)
  enabled      Boolean                  @default(true)
  interactiveEnabled Boolean            @default(false)
  warRoomsEnabled    Boolean            @default(false)
  defaultWarRoomMembershipType WarRoomMembershipType @default(STANDARD)
  defaultMeetingOrganizerUpn String?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  updatedBy    String?
  updater      User? @relation("MicrosoftTeamsConfigUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  @@index([enabled])
}

model MicrosoftTeamsInstallation {
  id             String   @id @default(cuid())
  tenantId       String
  teamId         String
  teamName       String?
  channelId      String?
  serviceUrl     String?
  conversationId String?
  botRecipientId String?
  installedBy    String?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  installer    User? @relation("MicrosoftTeamsInstallationInstaller", fields: [installedBy], references: [id], onDelete: SetNull)
  destinations MicrosoftTeamsDestination[]
  @@unique([tenantId, teamId])
  @@index([tenantId])
  @@index([teamId])
  @@index([enabled])
}

model MicrosoftTeamsDestination {
  id             String   @id @default(cuid())
  serviceId      String
  tenantId       String
  teamId         String
  channelId      String
  channelName    String?
  teamName       String?
  installationId String?
  enabled        Boolean  @default(true)
  interactiveEnabled Boolean @default(false)
  warRoomEnabled    Boolean  @default(false)
  warRoomAutoCreate Boolean  @default(true)
  warRoomMembershipType WarRoomMembershipType?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      String?
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  installation MicrosoftTeamsInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  updater      User? @relation("MicrosoftTeamsDestinationUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)
  messages     MicrosoftTeamsIncidentMessage[]
  @@unique([serviceId, tenantId, teamId, channelId])
  @@index([serviceId])
  @@index([tenantId, teamId])
  @@index([channelId])
  @@index([installationId])
  @@index([enabled])
}

model MicrosoftTeamsIncidentMessage {
  id                     String    @id @default(cuid())
  incidentId             String
  destinationId          String
  conversationId         String?
  messageId              String?
  channelId              String?
  tenantId               String?
  teamId                 String?
  mutationLeaseToken     String?
  mutationLeaseExpiresAt DateTime?
  createOperationId      String?
  createState            String    @default("NONE")
  messageGeneration      Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  destination MicrosoftTeamsDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  @@unique([incidentId, destinationId])
  @@index([incidentId])
  @@index([destinationId])
  @@index([conversationId])
  @@index([messageId])
  @@index([mutationLeaseExpiresAt])
  @@index([createState])
}

model IncidentWarRoom {
  id                    String                @id @default(cuid())
  incidentId            String
  provider              WarRoomProvider
  generation            Int                   @default(1)
  state                 WarRoomState          @default(PROVISIONING)
  destinationId         String?
  installationId        String?
  providerTenantId      String?
  providerContainerId   String?
  providerChannelId     String?
  providerChannelName   String?
  providerChannelUrl    String?
  membershipType        WarRoomMembershipType?
  commandMessageId      String?
  commandConversationId String?
  commandCreateAttemptedAt DateTime?
  messageGeneration     Int                   @default(1)
  projectionVersion     Int                   @default(0)
  lastProjectedVersion  Int                   @default(0)
  lastProjectedAt       DateTime?
  projectionLeaseToken  String?
  projectionLeaseExpiresAt DateTime?
  provisioningToken     String?
  provisioningStartedAt DateTime?
  createAttemptedAt     DateTime?
  createOperationId     String?
  // Durable planned identity for this generation — set BEFORE conversations.create
  // and never overwritten by reconciliation. Lost-response recovery reconciles
  // only this exact name (plus marker); generic name fallback is forbidden.
  plannedExternalName   String?
  readyAt               DateTime?
  closedAt              DateTime?
  archivedAt            DateTime?
  // Resolve-driven close intent — persisted for AMBIGUOUS rooms so the
  // close lifecycle waits for external identity rather than stranding it.
  closeRequestedAt      DateTime?
  lastError             String?
  lastErrorCode         String?
  health                WarRoomHealthState    @default(HEALTHY)
  lastReconciledAt      DateTime?
  // Terminal drift debt: set when reconciliation window expires with
  // unverified external outcome. A low-frequency lane scans these rooms
  // by marker/planned name and archives any orphan channel idempotently
  // without reopening the lifecycle. Cleared on next marker scan.
  externalCleanupPending     Boolean   @default(false)
  externalCleanupReason      String?
  externalCleanupLastAttemptAt DateTime?
  externalCleanupCompletedAt DateTime?
  metadata              Json?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  incident     Incident             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  participants WarRoomParticipant[]
  @@unique([incidentId, provider, generation])
  @@index([incidentId, provider, state])
  @@index([provider, providerTenantId, providerContainerId, providerChannelId])
  @@index([state, provisioningStartedAt])
  @@index([state, health, externalCleanupPending, lastReconciledAt])
}

model IncidentMeeting {
  id                    String                  @id @default(cuid())
  incidentId            String
  provider              IncidentMeetingProvider
  generation            Int                     @default(1)
  state                 IncidentMeetingState    @default(REQUESTED)
  health                IncidentMeetingHealth   @default(HEALTHY)
  externalId            String                  @unique
  joinUrl               String
  joinWebUrl            String?
  conferenceId          String?
  tollNumber            String?
  tollFreeNumber        String?
  organizerEmail        String?
  providerMeetingId     String?
  provisioningToken     String?
  provisioningStartedAt DateTime?
  closeStartedAt        DateTime?
  closeToken            String?
  readyAt               DateTime?
  closedAt              DateTime?
  cleanupAttemptedAt    DateTime?
  cleanupRetryCount     Int                     @default(0)
