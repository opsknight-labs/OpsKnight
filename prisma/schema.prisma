  channelId   String
  messageTs   String
  pinnedBy    String?
  createdAt   DateTime @default(now())
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, channelId, messageTs])
  @@index([incidentId])
  @@index([workspaceId, channelId])
}

model ChatOpsConfig {
  id                      String   @id @default("default")
  enabled                 Boolean  @default(false)
  autoCreateOnUrgency     String[] @default(["HIGH"])
  autoCreateOnPriority    String[] @default(["P1", "P2"])
  channelPrefix           String   @default("inc")
  archiveOnResolve        Boolean  @default(true)
  defaultVideoBridge      String   @default("JITSI")
  customBridgeUrlTemplate String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  @@unique([id])
}

// Centralized DSAR (Data Subject Access Request) workflow record.
// All lifecycle transitions must go through transitionPrivacyRequest() —
// no route or UI action should write status/timestamps directly.
model PrivacyRequest {
  id              String                    @id @default(cuid())
  subjectType     PrivacyRequestSubjectType @default(USER)
  subjectId       String
  requestType     PrivacyRequestType
  status          PrivacyRequestStatus      @default(RECEIVED)
  requestedAt     DateTime                  @default(now())
  verifiedAt      DateTime?
  completedAt     DateTime?
  requestedById   String?
  assignedToId    String?
  notes           String?
  rejectionReason String?
  metadata        Json?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  requestedBy       User?                   @relation("PrivacyRequestRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  assignedTo        User?                   @relation("PrivacyRequestAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  exportArtifacts   PrivacyExportArtifact[]
  erasureExecution  PrivacyErasureExecution?

  @@index([subjectType, subjectId])
  @@index([status, requestType])
  @@index([assignedToId])
  @@index([createdAt])
}

// A generated, encrypted-at-rest export artifact tied 1:1 to a PrivacyRequest.
// Short-lived by design: expiresAt is enforced both by the download route and
// a cleanup job, never by client-side trust.
model PrivacyExportArtifact {
  id               String                      @id @default(cuid())
  requestId        String
  status           PrivacyExportArtifactStatus @default(PENDING)
  storageKey       String?
  // Encrypted (AES-256-GCM envelope) base64 zip payload. Phase 2 stores the
  // artifact inline rather than introducing an object-storage dependency.
  encryptedPayload String?
  checksum         String?
  sizeBytes        Int?
  downloadCount    Int                         @default(0)
  failureReason    String?
  createdAt        DateTime                    @default(now())
  expiresAt        DateTime
  lastDownloadedAt DateTime?

  request PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([status, expiresAt])
}

// Tracks execution of an ERASURE request. One row per request (unique
// requestId) so re-invoking execute() is naturally idempotent: a COMPLETED
// execution short-circuits without touching any data a second time.
// resultSummary stores only per-domain counts (see src/lib/privacy/erasure/policy.ts)
// — never subject PII.
model PrivacyErasureExecution {
  id                    String                        @id @default(cuid())
  requestId             String                        @unique
  status                PrivacyErasureExecutionStatus @default(PENDING)
  planVersion           Int                           @default(1)
  resultSummary         Json?
  failureCode           String?
  // True when execute() completed but the plan contained a MANUAL_REVIEW_DOMAIN_IDS
  // domain with a non-zero count (e.g. free-text incident notes, audit log
  // details). The PrivacyRequest is deliberately NOT auto-transitioned to
  // COMPLETED in that case — an operator must review and complete it via the
  // standard transitionPrivacyRequest() state machine.
  manualReviewRequired  Boolean                       @default(false)
  // Set the instant the destructive delete/anonymize transaction commits.
  // NULL means no data has been touched yet; once set, a retry must never
  // re-run discovery/mutation \u2014 the subject is already gone \u2014 and a
  // subsequent finalization failure is distinguishable from "the subject
  // vanished through some unrelated path before we ever got here".
  mutationCommittedAt   DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  request PrivacyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([status])
}

// A retention hold protects a specific resource from being deleted by the
// automated cleanup job. Multiple holds can exist on the same resource; the
// resource is protected while ANY active hold exists. The hold row is retained
// forever as compliance evidence even after the resource is eventually deleted.
model DataRetentionHold {
  id                String   @id @default(cuid())

  scopeType         RetentionHoldScopeType
  scopeId           String

  reason            String
  externalReference String?

  createdById       String?
  releasedById      String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  expiresAt         DateTime?
  releasedAt        DateTime?

  createdBy         User? @relation("RetentionHoldCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  releasedBy        User? @relation("RetentionHoldReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([scopeType, scopeId])
  @@index([scopeType, scopeId, releasedAt])
  @@index([expiresAt, releasedAt])
  @@index([createdAt])
}

enum EncryptionMigrationMode {
  PREVIEW
  MIGRATE
  VERIFY
}

enum EncryptionMigrationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// Represents an execution of the encryption migration and verification lifecycle.
model EncryptionMigrationRun {
  id                           String                          @id @default(cuid())
  mode                         EncryptionMigrationMode         @default(PREVIEW)
  status                       EncryptionMigrationStatus       @default(PENDING)
  registryFingerprint          String
  activeKeyId                  String?
  totalRecords                 Int                             @default(0)
  processedRecords             Int                             @default(0)
  migratedRecords              Int                             @default(0)
  errorRecords                 Int                             @default(0)
  skippedRecords               Int                             @default(0)
  conflictRecords              Int                             @default(0)
  safeForDatabaseKeyRetirement Json?                           @default("[]")
  errorMessage                 String?
  startedAt                    DateTime?
  completedAt                  DateTime?
  initiatedById                String?
  createdAt                    DateTime                        @default(now())
  updatedAt                    DateTime                        @updatedAt

  initiatedBy                  User?                           @relation("EncryptionRunInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  targetStates                 EncryptionMigrationTargetState[]
  issues                       EncryptionMigrationIssue[]

  @@index([status, mode])
  @@index([createdAt])
  @@index([registryFingerprint])
}

// Checkpoint state per encryption target in a run.
model EncryptionMigrationTargetState {
  id             String                    @id @default(cuid())
  runId          String
  targetId       String
  status         EncryptionMigrationStatus @default(PENDING)
  cursor         String?
  totalCount     Int                       @default(0)
  processedCount Int                       @default(0)
  migratedCount  Int                       @default(0)
  errorCount     Int                       @default(0)
  conflictCount  Int                       @default(0)
  keysDetected   Json?                     @default("{}")
  inspectionStats Json?                    @default("{}")
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  run            EncryptionMigrationRun    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, targetId])
  @@index([runId, status])
}

// Audit record for issues encountered during encryption migration (strictly no plaintext or ciphertext).
model EncryptionMigrationIssue {
  id             String                 @id @default(cuid())
  runId          String
  targetId       String
  recordId       String
  fieldPath      String
  classification String
  errorMessage   String?
  createdAt      DateTime               @default(now())

  run            EncryptionMigrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, targetId])
  @@index([runId, classification])
}

