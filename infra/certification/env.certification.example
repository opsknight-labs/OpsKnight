# Environment variables for OpsKnight Phase 4 Production Certification
OPSKNIGHT_IMAGE=opsknight:certification-local
APP_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025
POSTGRES_PORT=5432
POSTGRES_USER=opsknight
POSTGRES_PASSWORD=opsknight_cert_secure_pw_2026
POSTGRES_DB=opsknight_certification_db
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=cert_secret_key_at_least_32_chars_long_2026
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COMPLIANCE_MONITORING_ENABLED=true
COMPLIANCE_MONITOR_INTERVAL_MINUTES=5
COMPLIANCE_DRIFT_NOTIFICATIONS_ENABLED=true
COMPLIANCE_DRIFT_RENOTIFY_COOLDOWN_MINUTES=60
NOTIFICATION_CONTROL_PLANE_PERSONAL=true
