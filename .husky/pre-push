echo "🚀 Running pre-push checks..."
echo "   (These are more thorough than pre-commit)"
echo ""

# Get the current branch
BRANCH=$(git rev-parse --abbrev-ref HEAD)
echo "📍 Current branch: $BRANCH"

# Block pushing to protected branches - must use feature branches
PROTECTED_BRANCHES="main master production develop"
for protected in $PROTECTED_BRANCHES; do
  if [ "$BRANCH" = "$protected" ]; then
    echo ""
    echo "🚫 BLOCKED: Direct push to '$BRANCH' is not allowed!"
    echo ""
    echo "   You must use a feature branch and create a pull request."
    echo ""
    echo "   Steps to fix:"
    echo "   1. Create a new branch:  git checkout -b feature/name or fix/name"
    echo "   2. Commit your changes:  git add . && git commit -m 'your message'"
    echo "   3. Push the branch:      git push -u origin your-branch-name"
    echo "   4. Create a PR on GitHub/GitLab"
    echo ""
    exit 1
  fi
done

# Full TypeScript check
echo ""
echo "🔷 Running full TypeScript check..."
npx tsc --noEmit || {
  echo "❌ TypeScript check failed. Please fix type errors before pushing."
  exit 1
}

# Run all unit tests
echo ""
echo "🧪 Running all unit tests..."
npx vitest run -c vitest.unit.config.ts || {
  echo "❌ Unit tests failed. Please fix failing tests before pushing."
  exit 1
}

# Build check (using separate dist dir to avoid lockfile contention)
echo ""
echo "🏗️  Verifying build..."
# Use a separate build directory for pre-push checks to avoid locking the dev server
# Clean up previous build artifacts to avoid stale type errors
npm run build || {
  echo "❌ Build failed. Please fix build errors before pushing."
  exit 1
}
echo "   ✓ Build successful"


# Security audit (non-blocking warning)
echo ""
echo "🔒 Running security audit..."
npm audit --audit-level=high 2>/dev/null || {
  echo "⚠️  Security vulnerabilities detected. Consider running 'npm audit fix'"
}

# Check for dependency updates (informational)
echo ""
echo "📦 Checking for outdated dependencies..."
OUTDATED=$(npm outdated --depth=0 2>/dev/null | tail -n +2 | wc -l)
if [ "$OUTDATED" -gt 0 ]; then
  echo "   ⚠️  $OUTDATED package(s) have updates available"
fi

echo ""
echo "✅ Pre-push checks passed! Your code is ready to push."
