echo "🚀 Running pre-push checks..."
echo "   (These are more thorough than pre-commit)"
echo ""

# Get the current branch
BRANCH=$(git rev-parse --abbrev-ref HEAD)
echo "📍 Current branch: $BRANCH"

# Block pushing to protected branches - must use feature branches
PROTECTED_BRANCHES="main master production develop"
for protected in $PROTECTED_BRANCHES; do
  if [ "$BRANCH" = "$protected" ]; then
    echo ""
    echo "🚫 BLOCKED: Direct push to '$BRANCH' is not allowed!"
    echo ""
    echo "   You must use a feature branch and create a pull request."
    echo ""
    echo "   Steps to fix:"
    echo "   1. Create a new branch:  git checkout -b feature/name or fix/name"
    echo "   2. Commit your changes:  git add . && git commit -m 'your message'"
    echo "   3. Push the branch:      git push -u origin your-branch-name"
    echo "   4. Create a PR on GitHub/GitLab"
    echo ""
    exit 1
  fi
done

# Full TypeScript check
echo ""
echo "🔷 Running full TypeScript check..."
npx tsc --noEmit || {
  echo "❌ TypeScript check failed. Please fix type errors before pushing."
  exit 1
}

# Unit tests: only those that import a changed file (CI's PR gate runs the whole suite).
# FULL_PUSH=1 runs everything, including a production build, before the push.
echo ""
echo "🧪 Running unit tests..."
BASE=$(git merge-base HEAD origin/develop 2>/dev/null || git merge-base HEAD origin/main 2>/dev/null || true)
if [ "${FULL_PUSH:-}" = 1 ] || [ -z "$BASE" ]; then
  npx vitest run -c vitest.unit.config.ts --maxWorkers=2 || {
    echo "❌ Unit tests failed. Please fix failing tests before pushing."
    exit 1
  }
  echo ""
  echo "🏗️  Verifying build..."
  npm run build || {
    echo "❌ Build failed. Please fix build errors before pushing."
    exit 1
  }
else
  CHANGED_TS=$(git diff --name-only --diff-filter=d "$BASE" HEAD -- '*.ts' '*.tsx')
  if [ -z "$CHANGED_TS" ]; then
    echo "   ⏭️  No TypeScript changes; skipped."
  else
    # shellcheck disable=SC2086
    npx vitest related --run -c vitest.unit.config.ts --maxWorkers=2 --passWithNoTests $CHANGED_TS || {
      echo "❌ Unit tests failed. Please fix failing tests before pushing."
      exit 1
    }
  fi
fi

# Security audit (non-blocking warning)
echo ""
echo "🔒 Running security audit..."
npm audit --audit-level=high 2>/dev/null || {
  echo "⚠️  Security vulnerabilities detected. Consider running 'npm audit fix'"
}

# Check for dependency updates (informational)
echo ""
echo "📦 Checking for outdated dependencies..."
OUTDATED=$(npm outdated --depth=0 2>/dev/null | tail -n +2 | wc -l)
if [ "$OUTDATED" -gt 0 ]; then
  echo "   ⚠️  $OUTDATED package(s) have updates available"
fi

# Database checks: pull requests no longer run them in CI (Actions volume), so they run here
# whenever the push changes something a database test can see (same rule as CI's change detection).
echo ""
echo "🗄️  Database checks..."
BASE=$(git merge-base HEAD origin/develop 2>/dev/null || git merge-base HEAD origin/main 2>/dev/null || true)
BACKEND=true
if [ -n "$BASE" ] && CHANGED=$(git diff --name-only "$BASE" HEAD) && [ -n "$CHANGED" ]; then
  BACKEND=false
  while IFS= read -r f; do
    case "$f" in
      docs/*|plans/*|artifacts/*|reports/*|public/*|*.md|.github/*) ;;
      src/components/*|tests/components/*|*.css|*.svg|*.png|*.jpg|*.jpeg|*.webp|*.gif|*.woff|*.woff2) ;;
      *) BACKEND=true ;;
    esac
  done <<EOF_CHANGED
$CHANGED
EOF_CHANGED
fi
if [ "$BACKEND" = false ]; then
  echo "   ⏭️  No backend changes since $(git rev-parse --short "$BASE"); skipped."
elif [ "${SKIP_DB_TESTS:-}" = 1 ]; then
  echo "   ⚠️  SKIP_DB_TESTS=1: database checks skipped. CI does not run them on pull requests."
else
  bash scripts/local-db-tests.sh || {
    echo "❌ Database checks failed. Fix them before pushing (SKIP_DB_TESTS=1 skips once)."
    exit 1
  }
fi

echo ""
echo "✅ Pre-push checks passed! Your code is ready to push."
