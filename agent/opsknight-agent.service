[Unit]
Description=OpsKnight Runbook Agent
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=opsknight-agent
Group=opsknight-agent
UMask=0077
StateDirectory=opsknight-agent
StateDirectoryMode=0700
ConfigurationDirectory=opsknight-agent
ConfigurationDirectoryMode=0755
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
EnvironmentFile=-/etc/opsknight-agent/agent.env
ExecStart=/opt/opsknight-agent/runtime/bin/node /opt/opsknight-agent/opsknight-agent.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

