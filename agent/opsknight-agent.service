[Unit]
Description=OpsKnight Runbook Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opsknight-agent
Group=opsknight-agent
EnvironmentFile=/etc/opsknight-agent/agent.env
ExecStart=/usr/bin/node /usr/local/lib/opsknight-agent/opsknight-agent.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opsknight-agent

[Install]
WantedBy=multi-user.target
