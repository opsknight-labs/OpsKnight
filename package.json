{
  "name": "opsknight",
  "version": "2.1.2",
  "description": "Transparent, self-hosted incident operations from alert ingestion and on-call routing through response, customer communication, and learning.",
  "keywords": [
    "incident-management",
    "on-call",
    "schedules",
    "escalation-policies",
    "status-page",
    "sre",
    "devops",
    "monitoring",
    "alerts"
  ],
  "author": "Dushyant Rahangdale",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/opsknight-labs/opsknight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsknight-labs/opsknight.git"
  },
  "bugs": {
    "url": "https://github.com/opsknight-labs/opsknight/issues"
  },
  "private": false,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node .next/standalone/server.js",
    "start:dev": "next start",
    "start:prod": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint . --max-warnings 100",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:ci": "npx vitest run --no-file-parallelism --maxWorkers=1 --reporter=default --reporter=junit --outputFile=reports/junit.xml",
    "test:unit": "vitest run -c vitest.unit.config.ts",
    "test:int": "vitest run -c vitest.int.config.ts --no-file-parallelism",
    "test:ci:unit": "npx vitest run -c vitest.unit.config.ts --reporter=default --reporter=junit --outputFile=reports/junit-unit.xml",
    "test:ci:db": "npx vitest run -c vitest.int.config.ts --no-file-parallelism --maxWorkers=1 --reporter=default --reporter=junit --outputFile=reports/junit-db.xml",
    "test:authorization": "vitest run -c vitest.unit.config.ts tests/lib/rbac-read-guards.test.ts tests/architecture/rbac-page-guards.test.ts",
    "seed:dashboard": "ts-node --project tsconfig.script.json scripts/dev/seed-dashboard-live.ts",
    "load:dashboard": "ts-node --project tsconfig.script.json scripts/dev/load-dashboard-live.ts",
    "certify:dashboard:replicas": "ts-node --project tsconfig.script.json scripts/dev/certify-dashboard-replicas.ts",
    "test:e2e:dashboard": "playwright test -c playwright.dashboard.config.ts",
    "test:all": "npm run lint:check && npm run test:run",
    "perf:budgets": "node scripts/perf/check-performance-budgets.cjs",
    "OpsKnight": "node ./scripts/OpsKnight.mjs",
    "ops": "node ./scripts/OpsKnight.mjs",
    "build:scripts": "tsc scripts/auto-recover-migrations.ts --rootDir . --outDir scripts/dist --module commonjs --target es2020 --esModuleInterop --skipLibCheck",
    "backfill:action-items": "ts-node --project tsconfig.script.json scripts/backfill-action-items.ts",
    "certify:collaboration": "npm run certify:collaboration:preflight",
    "certify:collaboration:preflight": "ts-node -r tsconfig-paths/register --project tsconfig.script.json scripts/certify-incident-collaboration-preflight.ts",
    "prisma:validate": "node scripts/validate-migrations.cjs",
    "integrations:encrypt-legacy-keys:dry-run": "ts-node -r tsconfig-paths/register --project tsconfig.script.json scripts/integrations/encrypt-legacy-routing-keys.ts",
    "integrations:encrypt-legacy-keys": "ts-node -r tsconfig-paths/register --project tsconfig.script.json scripts/integrations/encrypt-legacy-routing-keys.ts --apply",
    "prisma:health": "node scripts/check-migration-health.cjs",
    "prisma:auto-recover": "node --loader ts-node/esm scripts/auto-recover-migrations.ts",
    "prisma:migrate:safe": "npm run prisma:validate && npm run prisma:health && npx prisma migrate deploy && npm run prisma:indexes:status-platform && npm run prisma:indexes:sla-scheduler && npm run prisma:indexes:voice-attempts && npm run prisma:backfill:automation-source && node scripts/prepare-authentication-diagnostics.cjs",
    "prisma:backfill:automation-source": "node scripts/backfill-automation-source-classification.cjs",
    "prisma:indexes:status-platform": "node scripts/create-status-platform-online-indexes.cjs",
    "prisma:indexes:sla-scheduler": "node scripts/create-sla-scheduler-online-index.cjs",
    "prisma:indexes:voice-attempts": "node scripts/create-voice-attempt-online-indexes.cjs",
    "prepare": "husky install",
    "security:check": "npm audit && npm run lint:check",
    "lint:report": "eslint . --format @microsoft/eslint-formatter-sarif --output-file reports/security.sarif",
    "docs:sync": "scripts/sync-docs-to-website.sh",
    "docs:discover": "node scripts/docs/discover-capabilities.mjs",
    "docs:discover:write": "node scripts/docs/discover-capabilities.mjs --output generated/docs-discovery/current.json",
    "docs:test": "node --test tests/docs/tooling/*.test.mjs",
    "docs:journeys": "playwright test -c playwright.docs.config.ts",
    "docs:map": "node scripts/docs/build-doc-map.mjs",
    "docs:reference": "node scripts/docs/generate-reference.mjs",
    "docs:integrations": "node scripts/docs/generate-integrations.mjs",
    "docs:capacity": "node scripts/docs/generate-capacity-reference.mjs",
    "docs:routes": "node scripts/docs/generate-route-contract.mjs",
    "docs:v15-parity": "node scripts/docs/generate-v15-parity.mjs",
    "docs:claims": "node scripts/docs/check-dangerous-claims.mjs",
    "docs:surface-parity": "node scripts/docs/check-surface-parity.mjs",
    "docs:frontmatter": "node scripts/docs/check-frontmatter.mjs",
    "docs:evidence": "node scripts/docs/check-evidence.mjs",
    "docs:features": "node scripts/docs/check-feature-graph.mjs",
    "docs:impact": "node scripts/docs/check-impact.mjs",
    "docs:links": "node scripts/check-docs-links.cjs",
    "docs:capabilities": "node scripts/check-docs-capabilities.cjs",
    "docs:certify": "node scripts/docs/certify.mjs",
    "docs:certify:release": "node scripts/docs/certify.mjs --release",
    "docs:certify:external": "node scripts/docs/certify.mjs --external-runtime",
    "docs:certify:static": "node scripts/docs/certify.mjs --static",
    "docs:crawl-site": "node scripts/docs/crawl-rendered-site.mjs",
    "readme:capture": "playwright test -c playwright.readme.config.ts",
    "readme:assets": "node scripts/readme/compose-assets.mjs",
    "readme:refresh": "npm run readme:capture && npm run readme:assets",
    "docs:lint": "npm run docs:frontmatter && npm run docs:links && npm run docs:capabilities && npm run docs:evidence",
    "load:seed": "ts-node -r tsconfig-paths/register --project tsconfig.script.json tests/load/helpers/seed.ts",
    "seed:runbooks:dev": "ts-node -r tsconfig-paths/register --project tsconfig.script.json scripts/seed-runbooks-dev.ts",
    "load:cleanup": "ts-node -r tsconfig-paths/register --project tsconfig.script.json tests/load/helpers/cleanup.ts",
    "load:verify": "ts-node -r tsconfig-paths/register --project tsconfig.script.json tests/load/helpers/verify-results.ts",
    "load:metrics": "ts-node -r tsconfig-paths/register --project tsconfig.script.json tests/load/helpers/metrics.ts",
    "load:providers": "ts-node -r tsconfig-paths/register --project tsconfig.script.json tests/load/providers/server.ts",
    "load:certify": "ts-node -r tsconfig-paths/register --project tsconfig.script.json tests/load/helpers/topology.ts",
    "api:clients": "TS_NODE_PROJECT=tsconfig.script.json node -r ts-node/register -r tsconfig-paths/register scripts/api-v2/generate-clients.ts",
    "api:clients:check": "npm run api:clients -- --check",
    "test:api:clients": "vitest run tests/unit/api-v2-sdk.test.ts && python3 -m unittest discover -s tests/sdk -p \"test_*.py\"",
    "certify:api:clients:live": "node tests/sdk/live-workflows.mjs",
    "certify:scim:unit": "vitest run --no-file-parallelism --maxWorkers=1 tests/components/scim-settings-consistency.test.tsx tests/lib/scim.test.ts tests/lib/scim-protocol.test.ts tests/lib/oidc-identity-resolution.test.ts tests/lib/auth-control-actor.test.ts tests/lib/session-security-projection.test.ts tests/lib/auth-oidc-unit.test.ts tests/lib/auth-session-lifecycle.test.ts tests/lib/auth-oidc-provider-compat.test.ts tests/lib/authorization-cache-boundary.test.ts tests/lib/microsoft-teams-identity.test.ts tests/api/scim-users.test.ts tests/api/scim-groups.test.ts tests/api/scim-metadata.test.ts",
    "certify:scim:db": "SCIM_CERTIFICATION=1 vitest run --no-file-parallelism --maxWorkers=1 tests/integration/scim-lifecycle-database.test.ts tests/integration/scim-capacity-database.test.ts",
    "certify:scim:baseline": "node scripts/scim/certify-baseline.mjs",
    "certify:scim:upgrade": "node scripts/scim/certify-upgrade.mjs",
    "certify:scim:snapshot": "node scripts/scim/certify-snapshot-upgrade.mjs",
    "certify:scim:sessions": "node scripts/scim/certify-session-replicas.mjs",
    "certify:scim:http": "node scripts/scim/certify-http-capacity.mjs",
    "certify:scim:replicas": "node scripts/scim/certify-replicas.mjs",
    "certify:scim:outage": "node scripts/scim/certify-outage.mjs",
    "certify:scim:browser": "playwright test --config playwright.scim.config.ts",
    "api:coverage": "TS_NODE_PROJECT=tsconfig.script.json node -r ts-node/register -r tsconfig-paths/register scripts/api-v2/coverage-matrix.ts",
    "mcp:coverage": "TS_NODE_PROJECT=tsconfig.script.json node -r ts-node/register -r tsconfig-paths/register scripts/mcp/coverage-matrix.ts",
    "test:mcp": "vitest run --no-file-parallelism --maxWorkers=1 tests/mcp",
    "test:mcp:db": "vitest run -c vitest.int.config.ts --no-file-parallelism --maxWorkers=1 tests/integration/mcp-security-database.test.ts tests/integration/mcp-database-isolation.test.ts tests/integration/mcp-query-profile.test.ts tests/integration/mcp-runbook-approval.test.ts tests/integration/mcp-postmortem-context.test.ts tests/integration/mcp-operation-approval.test.ts tests/integration/mcp-approval-crash-safety.test.ts tests/integration/mcp-approval-teams-policies.test.ts tests/integration/mcp-approval-automation.test.ts tests/integration/mcp-approval-runbook-rules.test.ts tests/integration/mcp-client-metadata.test.ts",
    "test:mcp:db": "vitest run -c vitest.int.config.ts --no-file-parallelism --maxWorkers=1 tests/integration/mcp-security-database.test.ts tests/integration/mcp-database-isolation.test.ts tests/integration/mcp-query-profile.test.ts",
    "test:mcp:browser": "playwright test -c playwright.mcp.config.ts",
    "benchmark:mcp": "node scripts/mcp/benchmark.cjs",
    "certify:mcp": "node scripts/mcp/certify.cjs",
    "check:mcp:local": "node scripts/mcp/local-check.cjs",
    "certify:ingestion:db": "vitest run --config vitest.ingestion.config.ts",
    "certify:ingestion:unit": "vitest run --no-file-parallelism --maxWorkers=1 tests/ingestion/contract.test.ts tests/api/admin-ingestion.test.ts tests/api/ingestion-receipt.test.ts tests/lib/integration-middleware.test.ts tests/lib/integration-rate-limiter.test.ts tests/lib/incidents/event-lifecycle.test.ts tests/lib/event-outbox-runbook-trigger.test.ts tests/lib/event-notification-routing.test.ts tests/lib/event-side-effects.test.ts tests/lib/runtime-role.test.ts",
    "benchmark:ingestion": "node scripts/ingestion/benchmark.cjs",
    "certify:ingestion:upgrade": "node scripts/ingestion/certify-upgrade.cjs",
    "certify:ingestion:outage": "node scripts/ingestion/certify-outage.cjs",
    "certify:ingestion:http": "node scripts/ingestion/certify-http.cjs",
    "certify:ingestion:docker": "node scripts/ingestion/certify-docker.cjs"
  },
