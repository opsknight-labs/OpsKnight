{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": { "mode": { "type": "string", "enum": ["integrated", "split"] } }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeEnv",
        "nextauthUrl",
        "nextPublicAppUrl",
        "trustProxyHeaders",
        "trustedProxyHops",
        "appHostAliases",
        "redirectToCanonicalHost",
        "port",
        "hostname",
        "nextTelemetryDisabled",
        "notificationControlPlanePersonal"
      ],
      "properties": {
        "nodeEnv": { "type": "string" },
        "nextauthUrl": { "type": "string", "format": "uri" },
        "nextPublicAppUrl": { "type": "string", "format": "uri" },
        "trustProxyHeaders": { "type": ["string", "boolean"] },
        "trustedProxyHops": { "type": ["string", "integer"] },
        "appHostAliases": { "type": "string" },
        "redirectToCanonicalHost": { "type": ["string", "boolean"] },
        "port": { "type": ["string", "integer"] },
        "hostname": { "type": "string" },
        "nextTelemetryDisabled": { "type": ["string", "boolean"] },
        "notificationControlPlanePersonal": { "type": ["string", "boolean"] },
        "allowInsecureSecrets": { "type": ["string", "boolean"] },
        "runbookArtifactRetentionDays": { "type": "integer", "minimum": 1, "maximum": 3650 }
      }
    },
    "web": { "$ref": "#/definitions/webRole" },
    "scheduler": { "$ref": "#/definitions/schedulerRole" },
    "generalWorker": { "$ref": "#/definitions/workerRole" },
    "criticalWorker": { "$ref": "#/definitions/workerRole" },
    "bulkWorker": { "$ref": "#/definitions/workerRole" },
    "runbookWorker": { "$ref": "#/definitions/workerRole" },
    "statusProjector": { "$ref": "#/definitions/workerRole" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicaCount",
        "image",
        "url",
        "enrollmentToken",
        "policy",
        "persistence",
        "serviceAccount",
        "rbac",
        "networkPolicy",
        "resources",
        "nodeSelector",
        "tolerations",
        "affinity"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "const": 1 },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "url": { "type": "string" },
        "enrollmentToken": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allowedStepTypes",
            "systemdUnits",
            "dockerContainers",
            "kubernetesNamespaces",
            "bashCommandPatterns",
            "allowNonIdempotent",
            "maxRuntimeSeconds",
            "maxOutputBytes"
          ],
          "properties": {
            "allowedStepTypes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["LINUX_DIAGNOSTICS", "SYSTEMD", "DOCKER", "KUBERNETES", "BASH"]
              }
            },
            "systemdUnits": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "dockerContainers": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "kubernetesNamespaces": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "podmanContainers": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "kubernetesActions": { "type": "array", "uniqueItems": true, "items": { "enum": ["get", "describe", "logs", "events", "rollout-status", "rollout-restart", "scale"] } },
            "kubernetesMaxReplicas": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "networkHosts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
            "networkPorts": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
            "bashCommandPatterns": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "allowNonIdempotent": { "type": "boolean" },
            "maxRuntimeSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
            "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 10485760 }
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "size", "storageClass"],
          "properties": {
            "enabled": { "type": "boolean" },
            "size": { "$ref": "#/definitions/quantity" },
            "storageClass": { "type": "string" }
          }
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["create", "name"],
          "properties": { "create": { "type": "boolean" }, "name": { "type": "string" } }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kubernetesApiCIDRs"],
          "properties": {
            "kubernetesApiCIDRs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
              }
            }
          }
        },
        "rbac": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rules"],
          "properties": { "rules": { "type": "array", "items": { "type": "object" } } }
        },
        "resources": { "$ref": "#/definitions/resources" },
        "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" }
      }
    },
    "pgbouncer": { "$ref": "#/definitions/pgbouncer" },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressNamespaceLabels", "externalDatabaseCIDRs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespaceLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "externalDatabaseCIDRs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
          }
        },
        "additionalEgressPorts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "port", "maxApplicationConnections"],
      "properties": {
        "url": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "maxApplicationConnections": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "existingSecret", "caKey"],
          "properties": {
            "enabled": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "caKey": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "keys",
        "nextauthSecret",
        "apiKeySecret",
        "encryptionKey",
        "encryptionKeys",
        "setupSecret"
      ],
      "properties": {
        "existingSecret": { "type": "string" },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "databaseUrl",
            "directDatabaseUrl",
            "webDatabaseUrl",
            "nextauthSecret",
            "apiKeySecret",
            "encryptionKey",
            "encryptionKeys",
            "setupSecret",
            "postgresUser",
            "postgresPassword"
          ],
          "properties": {
            "databaseUrl": { "type": "string", "minLength": 1 },
            "directDatabaseUrl": { "type": "string", "minLength": 1 },
            "webDatabaseUrl": { "type": "string", "minLength": 1 },
            "nextauthSecret": { "type": "string", "minLength": 1 },
            "apiKeySecret": { "type": "string", "minLength": 1 },
            "encryptionKey": { "type": "string", "minLength": 1 },
            "encryptionKeys": { "type": "string", "minLength": 1 },
            "setupSecret": { "type": "string", "minLength": 1 },
            "postgresUser": { "type": "string", "minLength": 1 },
            "postgresPassword": { "type": "string", "minLength": 1 }
          }
        },
        "nextauthSecret": { "type": "string" },
        "apiKeySecret": { "type": "string" },
        "encryptionKey": { "type": "string", "pattern": "^$|^[0-9A-Fa-f]{64}$" },
        "encryptionKeys": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9._-]{1,64}:[0-9A-Fa-f]{64}(,[A-Za-z0-9._-]{1,64}:[0-9A-Fa-f]{64})*$"
        },
        "setupSecret": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "existingSecret": { "const": "" } } },
          "then": {
            "properties": {
              "nextauthSecret": { "minLength": 32 },
              "apiKeySecret": { "minLength": 32 }
            },
            "anyOf": [
              { "properties": { "encryptionKey": { "minLength": 64 } } },
              { "properties": { "encryptionKeys": { "minLength": 66 } } }
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runtime": {
            "properties": { "mode": { "const": "split" } },
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": {
          "scheduler": {
            "properties": { "profile": { "const": "maintenance" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "agent": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] }
        }
      },
      "then": {
        "properties": {
          "agent": {
            "properties": {
              "enrollmentToken": { "properties": { "existingSecret": { "minLength": 1 } } }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 100 },
    "poolSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["poolSize"],
      "properties": { "poolSize": { "type": "integer", "minimum": 1, "maximum": 100 } }
    },
    "quantity": { "type": ["string", "number"] },
    "resourcePair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "$ref": "#/definitions/quantity" },
        "memory": { "$ref": "#/definitions/quantity" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourcePair" },
        "limits": { "$ref": "#/definitions/resourcePair" }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "workerTuning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batchSize", "concurrency", "idlePollMs", "busyPollMs"],
      "properties": {
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 500 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 50 },
        "idlePollMs": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "busyPollMs": { "type": "integer", "minimum": 10, "maximum": 5000 }
      }
    },
    "webAutoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minReplicas", "maxReplicas"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "webRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "database",
        "resources",
        "autoscaling",
        "podDisruptionBudget",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "replicaCount": { "$ref": "#/definitions/replicaCount" },
        "database": { "$ref": "#/definitions/poolSize" },
        "resources": { "$ref": "#/definitions/resources" },
        "autoscaling": { "$ref": "#/definitions/webAutoscaling" },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "schedulerRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "profile",
        "database",
        "resources",
        "podDisruptionBudget",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "replicaCount": { "$ref": "#/definitions/replicaCount" },
        "profile": { "type": "string", "enum": ["full", "maintenance"] },
        "database": { "$ref": "#/definitions/poolSize" },
        "resources": { "$ref": "#/definitions/resources" },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "workerRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "database",
        "worker",
        "resources",
        "podDisruptionBudget",
        "terminationGracePeriodSeconds"
      ],
      "properties": {
        "replicaCount": { "$ref": "#/definitions/replicaCount" },
        "database": { "$ref": "#/definitions/poolSize" },
        "worker": { "$ref": "#/definitions/workerTuning" },
        "resources": { "$ref": "#/definitions/resources" },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "pgbouncer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicas",
        "image",
        "port",
        "poolMode",
        "maxClientConnections",
        "defaultPoolSize",
        "reservePoolSize",
        "maxPreparedStatements",
        "existingAuthSecret",
        "authFileKey",
        "podDisruptionBudget",
        "resources",
        "securityContext"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "$ref": "#/definitions/replicaCount" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": ["string", "null"], "pattern": "^$|^sha256:[a-fA-F0-9]{64}$" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "poolMode": { "type": "string", "enum": ["session", "transaction", "statement"] },
        "maxClientConnections": { "type": "integer", "minimum": 1 },
        "defaultPoolSize": { "type": "integer", "minimum": 1 },
        "reservePoolSize": { "type": "integer", "minimum": 0 },
        "maxPreparedStatements": { "type": "integer", "minimum": 0 },
        "existingAuthSecret": { "type": "string" },
        "authFileKey": { "type": "string", "minLength": 1 },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
        "resources": { "$ref": "#/definitions/resources" },
        "securityContext": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "allowPrivilegeEscalation",
            "capabilities",
            "runAsNonRoot",
            "runAsUser",
            "runAsGroup",
            "readOnlyRootFilesystem"
          ]
        }
      }
    }
  }
}
