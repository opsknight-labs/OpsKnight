  "probeSource": "const assert = require('node:assert/strict');\nconst fs = require('node:fs');\nrequire(process.cwd()+'/scripts/ingestion/isolated-runtime.cjs');\nconst db = require(process.cwd()+'/src/lib/prisma').default;\nconst {claimPendingJobs,claimPendingOperationalJobs,GENERAL_WORKER_EXCLUDED_JOB_TYPES} = require(process.cwd()+'/src/lib/jobs/queue');\nconst fields = new Set(['Node Type','Relation Name','Index Name','Actual Total Time','Actual Rows','Actual Loops','Rows Removed by Filter','Rows Removed by Index Recheck','Shared Hit Blocks','Shared Read Blocks']);\nconst bounded = node=>Object.fromEntries(Object.entries(node).flatMap(([key,value])=>key==='Plans'?[[key,value.map(bounded)]]:fields.has(key)?[[key,value]]:[]));\n(async()=>{\n const expected='ingestion_test_http_responder_preflight_20261025';\n assert.equal(new URL(process.env.DATABASE_URL).pathname,'/'+expected);\n const [state]=await db.$queryRaw`SELECT current_database() AS name,(SELECT count(*)::int FROM pg_stat_activity WHERE datname=current_database() AND pid<>pg_backend_pid() AND backend_type='client backend') AS clients`;\n assert.equal(state.name,expected);assert.equal(state.clients,0);\n assert.equal(await db.backgroundJob.count({where:{id:{startsWith:'responder-pressure-'}}}),20000);\n await db.$executeRaw`INSERT INTO \"BackgroundJob\" (id,type,payload,\"scheduledAt\",\"updatedAt\") SELECT 'responder-plan-'||n,'SCHEDULED_TASK'::\"JobType\",jsonb_build_object('task','EVENT_SIDE_EFFECT','lane','PERSONAL_NOTIFICATION','incidentId','owned-plan-'||n,'eventOrderAt','2000-01-01T00:00:00.000Z','effect','TRIGGER_ESCALATION_NOTIFICATIONS'),'2000-01-01'::timestamptz,clock_timestamp() FROM generate_series(1,10000) n`;\n const statements=[]; const original=db.$queryRaw;\n db.$queryRaw=async s=>{statements.push(s);return [];};\n try {\n  await claimPendingJobs(50,'SCHEDULED_TASK',[],{criticalEffectsOnly:true});\n  await claimPendingOperationalJobs(100,GENERAL_WORKER_EXCLUDED_JOB_TYPES,{excludeCriticalEffects:true});\n }finally{db.$queryRaw=original;}\n assert.equal(statements.length,3);\n const repeats=[];const rollback=new Error('rollback-plan');\n for(const lane of ['critical','general']){\n  // Opposite-lane rows are deliberately older than the desired lane.\n  if(lane==='critical') {\n   await db.$executeRaw`UPDATE \"BackgroundJob\" SET \"scheduledAt\"='1999-01-01'::timestamptz WHERE id LIKE 'responder-pressure-%'`;\n   await db.$executeRaw`UPDATE \"BackgroundJob\" SET \"scheduledAt\"='2000-01-01'::timestamptz WHERE id LIKE 'responder-plan-%'`;\n  }else{\n   await db.$executeRaw`UPDATE \"BackgroundJob\" SET \"scheduledAt\"='2000-01-01'::timestamptz WHERE id LIKE 'responder-pressure-%'`;\n   await db.$executeRaw`UPDATE \"BackgroundJob\" SET \"scheduledAt\"='1999-01-01'::timestamptz WHERE id LIKE 'responder-plan-%'`;\n  }\n  await db.$executeRaw`ANALYZE \"BackgroundJob\"`;\n  const statement=lane==='critical'?statements[0]:statements[2];\n  for(const newIndexes of [false,true,true,false]){\n   try{await db.$transaction(async tx=>{\n    if(!newIndexes){await tx.$executeRaw`DROP INDEX \"BackgroundJob_responder_live_order_idx\"`;await tx.$executeRaw`DROP INDEX \"BackgroundJob_general_live_order_idx\"`;}\n    const rows=await tx.$queryRawUnsafe('EXPLAIN (ANALYZE,BUFFERS,FORMAT JSON) '+statement.text,...statement.values);\n    const result=rows[0]['QUERY PLAN'][0]; repeats.push({lane,newIndexes,executionMs:result['Execution Time'],planningMs:result['Planning Time'],plan:bounded(result.Plan)});\n    throw rollback;\n   },{timeout:60000,maxWait:2000});}catch(e){if(e!==rollback)throw e;}\n  }\n }\n assert.equal(await db.backgroundJob.count({where:{status:'PROCESSING'}}),0);\n const evidence={certifiedEnterprise:false,passed:true,recordedAt:new Date().toISOString(),scope:'Rollback-only captured production claim SQL, 30,000 synthetic active rows on an owned fixture. Opposite lane ordered first; two existing lane indexes enabled vs transactionally dropped. No handler execution, native-image, historical-storage or throughput certification.',repeats};\n fs.writeFileSync('/private/tmp/ingestion-responder-plan-probe.json',JSON.stringify(evidence,null,2)+'\\n');\n console.log(JSON.stringify(repeats.map(({lane,newIndexes,executionMs})=>({lane,newIndexes,executionMs}))));\n})().catch(e=>{console.error(e);process.exitCode=1;}).finally(()=>db.$disconnect());\n",
