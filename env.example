# ==============================================
# OpsKnight Configuration File (.env)
# ==============================================
# 1. Copy this file to .env
# 2. Replace development values before production use.
# ==============================================

# ----------------------------------------------
# 1. DATABASE CONNECTION
# ----------------------------------------------
# Used when running the application directly on the host.
# Docker Compose builds its bundled-database URL internally; set
# OPSKNIGHT_DATABASE_URL below only when Compose should use a custom/managed DB.
DATABASE_URL="postgresql://opsknight:your_secure_password@localhost:5432/opsknight_db?sslmode=prefer&connection_limit=40"

# Optional Docker Compose full database URL override. Use this for managed
# PostgreSQL, TLS parameters, PgBouncer, or URI-encoded credentials, together
# with: docker compose -f docker-compose.yml -f docker-compose.external-db.yml up -d
# OPSKNIGHT_DATABASE_URL="postgresql://user:password@db.example.com:5432/opsknight_db?sslmode=require&connection_limit=40"

# ----------------------------------------------
# 2. APPLICATION SETTINGS
# ----------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Number of trusted reverse-proxy entries at the right edge of X-Forwarded-For.
# Keep 1 for a single ingress/load balancer; raise only for known internal hops.
TRUSTED_PROXY_HOPS=1

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=changeme_to_a_secure_random_string

# ----------------------------------------------
# 3. ENCRYPTION (REQUIRED IN PRODUCTION)
# ----------------------------------------------
# Generate with: openssl rand -hex 32
# Keep this stable and backed up; losing it means re-entering encrypted secrets.
ENCRYPTION_KEY=
# Rotation form (preferred when changing keys): first key encrypts, all keys decrypt.
# ENCRYPTION_KEYS=k2:NEW_64_HEX_KEY,k1:PREVIOUS_64_HEX_KEY

# ----------------------------------------------
# 4. DOCKER COMPOSE SETTINGS
# ----------------------------------------------
POSTGRES_USER=opsknight
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=opsknight_db
POSTGRES_PORT=5432
APP_PORT=3000

# Pin an immutable tag or digest in production.
# OPSKNIGHT_IMAGE=ghcr.io/opsknight-labs/opsknight:1.4.0

# ----------------------------------------------
# 5. SLACK (OPTIONAL DEVELOPMENT OVERRIDE)
# ----------------------------------------------
# Slack is normally configured in the UI under Settings > Integrations > Slack.
# SLACK_SIGNING_SECRET=

# ----------------------------------------------
# 6. MONITORING & METRICS (OPTIONAL)
# ----------------------------------------------
# PROMETHEUS_SCRAPE_TOKEN=
